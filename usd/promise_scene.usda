#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "PROMISE" (
        prepend references = @./promise.usdc@
    )
    {
        double3 xformOp:translate = (0, 0, 0.02)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def PhysicsScene "PhysicsScene"
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 1.62
    }

    def Cube "Ground" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        color3f[] primvars:displayColor = [(0.24, 0.25, 0.27)]
        double size = 1
        float3 xformOp:scale = (40, 40, 0.1)
        double3 xformOp:translate = (0, 0, -0.05)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def DomeLight "Sky"
    {
        float inputs:intensity = 700
    }

    def DistantLight "Sun"
    {
        float inputs:intensity = 1800
        float3 xformOp:rotateXYZ = (30, -35, -25)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }
}

