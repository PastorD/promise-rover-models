        <instance_geometry url="#geometry">
          <bind_material>
            <technique_common>
              <instance_material symbol="material" target="#material">
                <bind_vertex_input semantic="UVMap" input_semantic="TEXCOORD" input_set="0" />
              </instance_material>
            </technique_common>
          </bind_material>
        </instance_geometry>
      </node>
    </visual_scene>
  </library_visual_scenes>
  <scene>
    <instance_visual_scene url="#Scene" />
  </scene>
</COLLADA>